APP_NAME=CreatorOS
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://creatoros_user:change_me@localhost:5432/creatoros_dev
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-model
DEFAULT_IMAGE_PROVIDER=mock
DEFAULT_IMAGE_MODEL=
DEFAULT_TTS_PROVIDER=mock
DEFAULT_TTS_MODEL=
DEFAULT_TTS_VOICE=alloy
DEFAULT_VIDEO_PROVIDER=mock
DEFAULT_VIDEO_MODEL=kling-3.0-turbo
DEFAULT_RENDER_PROVIDER=mock
DEFAULT_ASSET_HOSTING_PROVIDER=mock
PROVIDER_TIMEOUT_SECONDS=30
OPENAI_IMAGE_TIMEOUT_SECONDS=300
KLING_VIDEO_TIMEOUT_SECONDS=900
KLING_VIDEO_POLL_INTERVAL_SECONDS=5
PROVIDER_MAX_RETRIES=3
FFMPEG_PATH=
CAPTION_FONT_NAME=Arial
CAPTION_FONT_FILE=
ARTIFACT_ROOT=artifacts
ASSETS_DIR=
LOGS_DIR=
PROMPTS_DIR=
# Optional credentials for real provider adapters. Mock remains the default.
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=creatoros
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
